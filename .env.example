# Копия в .env и заполнить. .env в репозиторий не коммитить.

# Telegram — аккаунт ассистента (my.telegram.org → API development tools)
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Владелец
OWNER_ID=
OWNER_NAME=Абу

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_SMART=claude-sonnet-5-5
# Цены, USD за 1M токенов (по прайсу Anthropic на дату установки)
PRICE_IN_FAST=
PRICE_OUT_FAST=
PRICE_IN_SMART=
PRICE_OUT_SMART=
DAILY_BUDGET_USD=1.00

# Мост и MT5
BRIDGE_KEY=
# пусто = %APPDATA%\MetaQuotes\Terminal\Common\Files\MrCasino
BRIDGE_ROOT=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_AUTORESTART=true
# пусто = символ из статуса робота
SYMBOL=

# Время
TZ=Asia/Bishkek
QUIET_HOURS=00:00-08:00

# Голос и звонки
VOICE=ru-RU-DmitryNeural
VOICE_TRADES=false
STT_MODEL=small
STT_DEVICE=auto
CALL_ON_CRITICAL=true
CALL_MAX_MIN=15

# Расписание
MORNING_HM=09:30
REPORT_HM=23:05
EVENING_ZONES_HM=22:30
WEEKLY=Sat 10:00

MSG_LEVEL=1
